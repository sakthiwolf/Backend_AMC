# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=mssql+pyodbc://amc_user:CHANGE_ME@localhost\SQLEXPRESS/AMCTracker?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_HOURS=8
REFRESH_TOKEN_DAYS=90
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
WHATSAPP_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
TIMEZONE=Asia/Kolkata

# Production (remote SQL Server, host,port). Real values live in
# deploy/iis/.env.production, which is not committed. URL-encode special
# characters in the password (@ = %40, # = %23).
# DATABASE_URL=mssql+pyodbc://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
