{
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=AMCTracker_DotnetDev;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Jwt": {
    "Secret": "dev-only-signing-key-not-for-production-0123456789"
  },
  "Reminders": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8000"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/amc-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
