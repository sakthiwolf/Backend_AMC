{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "amc-tracker",
    "Audience": "amc-tracker-app",
    "ExpireHours": 8
  },
  "Auth": {
    "RefreshTokenDays": 90,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "Username": "",
    "Password": "",
    "FullName": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Clock": {
    "TimeZone": "Asia/Kolkata"
  },
  "WhatsApp": {
    "Provider": "Wacto",
    "BaseUrl": "https://my.wacto.app",
    "ApiVersion": "v21.0",
    "PhoneNumberId": "",
    "Token": "",
    "AuthHeaderName": "Authorization",
    "AuthScheme": "Bearer",
    "TemplateLanguage": "en",
    "TimeoutSeconds": 15,
    "Templates": {
      "AMC": "amc_template",
      "Monthly": "monthly_template"
    }
  },
  "Reminders": {
    "Enabled": false,
    "RunAt": "09:00",
    "TestPhoneOnly": true,
    "TestPhone": "",
    "AdminUsernames": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/amc-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
