{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "amc-tracker",
    "Audience": "amc-tracker-app",
    "ExpireHours": 8
  },
  "Auth": {
    "RefreshTokenDays": 90,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Clock": {
    "TimeZone": "Asia/Kolkata"
  },
  "WhatsApp": {
    "BaseUrl": "https://graph.facebook.com/",
    "ApiVersion": "v21.0",
    "Token": "",
    "PhoneNumberId": "",
    "TemplateName": "amc_renewal_reminder",
    "LanguageCode": "en",
    "TestRecipient": ""
  },
  "Reminders": {
    "Enabled": true,
    "RunAt": "09:00"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/amc-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
