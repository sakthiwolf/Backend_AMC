{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": ""
  },
  "WhatsApp": {
    "Provider": "Fake"
  },
  "Reminders": {
    "Enabled": false,
    "TestPhoneOnly": true,
    "TestPhone": ""
  },
  "Swagger": {
    "Enabled": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8000"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/amc-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
