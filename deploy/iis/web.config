<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to the site root (next to the "app" folder). Adjust the two paths if
     the site is not at C:\inetpub\amc-api. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\inetpub\amc-api\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --proxy-headers --forwarded-allow-ips=127.0.0.1"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\inetpub\amc-api\logs\stdout"
                  startupTimeLimit="60"
                  requestTimeout="00:02:00"
                  processesPerApplication="1" />
    <!-- Temporary: shows the real error instead of the generic 500 page.
         Remove once the site works. -->
    <httpErrors errorMode="Detailed" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
